# Public webmaster verification tokens (not account passwords or API tokens).
# Leave empty when DNS TXT verification is used. Existing Yandex tag is preserved.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Set true ONLY for an intentionally non-indexable staging build.
# Production puerhdirect.ru must keep this false; verify rendered HTML after deployment.
SITE_NOINDEX=false
