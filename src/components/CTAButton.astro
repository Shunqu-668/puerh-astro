---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
  textRu?: string;
  textEn?: string;
}

const { href, variant = "primary", class: extraClass = "", textRu, textEn } = Astro.props;
const hasSlot = Astro.slots.has("default");
if (!hasSlot && !textRu && !textEn) throw new Error("CTAButton requires visible link text");

const base = "button tea-cta";

const variants = {
  primary: "primary",
  secondary: "secondary",
};
---

<a href={href} class={`${base} ${variants[variant]} ${extraClass}`}>
  {hasSlot ? <slot /> : <span>{textRu || textEn}</span>}
</a>
