---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
  textRu?: string;
  textEn?: string;
}

const { href, variant = "primary", class: extraClass = "", textRu, textEn } = Astro.props;

const base = "inline-flex items-center justify-center px-8 py-3.5 text-sm font-semibold rounded-lg transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.98] min-h-[44px]";

const variants = {
  primary: "site-cta-primary",
  secondary: "site-cta-secondary",
};
---

<a href={href} class={`site-cta ${base} ${variants[variant]} ${extraClass}`} title={textEn}>
  {textRu ? <span>{textRu}</span> : <slot />}
</a>
