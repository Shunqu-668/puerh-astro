---
interface Props {
  titleRu: string;
  titleEn: string;
  subtitleRu?: string;
  subtitleEn?: string;
  bgImage?: string;
  overlay?: boolean;
}
const { titleRu, titleEn, subtitleRu, subtitleEn, bgImage } = Astro.props;
---
<section class="inner-cover section-shell">
 <div><p class="eyebrow" lang="en">PUERH DIRECT / {titleEn}</p><h1 class="display-title">{titleRu}</h1>{(subtitleRu || subtitleEn) && <p class="inner-cover-description">{subtitleRu || subtitleEn}</p>}<slot /></div>
 {bgImage && <img src={bgImage} alt="" class="inner-cover-photo" width="400" height="260" loading="eager" />}
</section>
