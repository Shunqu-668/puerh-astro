---
interface Props {
  titleRu: string;
  titleEn: string;
  subtitleRu?: string;
  subtitleEn?: string;
  bgImage?: string;
  overlay?: boolean;
  compact?: boolean;
  imagePosition?: string;
}

const {
  titleRu,
  titleEn,
  subtitleRu,
  subtitleEn,
  bgImage,
  overlay = true,
  compact = false,
  imagePosition = 'center',
} = Astro.props;
---

<div class:list={["cover-hero relative flex items-center overflow-hidden", { "cover-hero-compact": compact }]}>
  {bgImage && (
    <img src={bgImage} alt="" style={{ objectPosition: imagePosition }} class="absolute inset-0 w-full h-full object-cover z-0" loading="eager" />
  )}
  {overlay && <div class="cover-hero-shade absolute inset-0 z-10"></div>}
  <div class="cover-hero-content relative z-20 mx-auto">
    <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
      <span class="block">{titleRu}</span>
    </h1>
    {(subtitleRu || subtitleEn) && (
      <p class="text-base md:text-lg text-gray-300 max-w-2xl">
        {subtitleRu && <span class="block">{subtitleRu}</span>}
        {subtitleEn && <span class="block text-gray-400 text-sm md:text-base mt-1">{subtitleEn}</span>}
      </p>
    )}
    <slot />
  </div>
</div>
