---
import { ClientRouter } from "astro:transitions";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { title, description, ogImage, canonicalURL } = Astro.props;
const baseUrl = "https://puerhdirect.ru";
const pageUrl = canonicalURL ? `${baseUrl}${canonicalURL}` : new URL(Astro.url.pathname, baseUrl).href;
const pageTitle = `${title.replace(/\s*[—|]\s*PUERH DIRECT\s*$/i, "")} — PUERH DIRECT`;
const imageUrl = ogImage || `${baseUrl}/images/images/logo.webp`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "PUERH DIRECT",
  alternateName: ["Puerh Direct Wholesale", "Пуэр Директ"],
  url: baseUrl,
  logo: `${baseUrl}/images/images/logo.webp`,
  description: "Прямые оптовые поставки пуэра из Гуанчжоу (Фанцунь). Wholesale puerh from China. Order quantity and shipping agreed individually.",
  email: "wholesale@puerhdirect.ru",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guangzhou",
    addressRegion: "Guangdong",
    addressCountry: "CN",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+86-13728005309",
    contactType: "sales",
    availableLanguage: ["Russian", "English", "Chinese"],
  },
  sameAs: ["https://t.me/sqvivi777"],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- Canonical -->
    <link rel="canonical" href={pageUrl} />

    <!-- A single bilingual URL is not a separate English language version. -->

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PUERH DIRECT" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />

    <!-- VK -->
    <meta property="vk:image" content={imageUrl} />

    <!-- GEO tags for Russia/CIS -->
    <meta name="geo.region" content="CN-GD" />
    <meta name="geo.placename" content="Гуанчжоу, Китай | Guangzhou, China" />
    <meta name="geo.position" content="23.1291;113.2644" />

    <!-- Yandex verification (replace with your code at https://webmaster.yandex.com) -->
    <meta name="yandex-verification" content="93e5aae716cf117c" />

    <link rel="icon" type="image/webp" href="/images/images/logo.webp" />

    <link rel="preload" as="image" href="/images/images/logo.webp" />

    <slot name="head" />

    <script>
      const productionHost = ['puerhdirect.ru', 'www.puerhdirect.ru'].includes(location.hostname);
      if (productionHost) {
        const w = window as any;
        w.ym = w.ym || function (...args: unknown[]) { (w.ym.a = w.ym.a || []).push(args); };
        w.ym.l = Date.now();
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://mc.yandex.ru/metrika/tag.js';
        document.head.append(tag);
        w.ym(109468811, 'init', { clickmap: true, accurateTrackBounce: true, trackLinks: true });
        let previousPage = location.pathname;
        document.addEventListener('astro:page-load', () => {
          if (location.pathname !== previousPage) {
            w.ym(109468811, 'hit', location.pathname, { title: document.title, referer: previousPage });
            previousPage = location.pathname;
          }
        });
      }
    </script>

    <!-- JSON-LD Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <a href="#main-content" class="skip-link">К содержанию</a>
    <Nav />
    <main id="main-content" class="pt-16" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
