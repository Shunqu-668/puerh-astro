---
import BrandLogo from './BrandLogo.astro';
const navItems = [
  { href: "/catalog/", ru: "Каталог", en: "Catalog" },
  { href: "/sample/", ru: "Образцы", en: "Samples" },
  { href: "/private-label/", ru: "Под своим брендом", en: "Private label" },
  { href: "/about/", ru: "О нас", en: "About" },
  { href: "/blog/", ru: "Блог", en: "Blog" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) => currentPath === href.replace(/\/$/, "") || currentPath.startsWith(href);
---
<header class="site-nav fixed top-0 left-0 right-0 z-50" data-scrolled="false" data-menu-open="false" data-scroll-hidden="false">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-5">
      <a href="/" class="nav-identity shrink-0" aria-label="PUERH DIRECT — Главная">
        <BrandLogo />
      </a>
      <nav class="hidden lg:flex items-center gap-1" aria-label="Основная навигация">
        {navItems.map(item => (
          <a href={item.href} title={item.en} aria-current={active(item.href) ? "page" : undefined}
            class={`px-3 py-2 text-sm font-medium rounded-md transition-colors ${active(item.href) ? "text-acid bg-accent-wash" : "text-soft hover:text-acid"}`}>
            {item.ru}
          </a>
        ))}
      </nav>
      <div class="flex items-center gap-3">
        <a href="/contact/#inquiry-form" class="nav-quote">Запросить цену</a>
        <button id="menu-btn" type="button" class="lg:hidden p-2 text-ink" aria-label="Меню" aria-controls="mobile-menu" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path id="menu-icon-open" stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="hidden lg:hidden pb-4 max-h-[calc(100dvh-4rem)] overflow-y-auto" aria-label="Мобильная навигация">
      {[...navItems, { href: "/faq/", ru: "Вопросы и ответы", en: "FAQ" }, { href: "/contact/", ru: "Контакты / Запросить цену", en: "Contact" }].map(item => (
        <a href={item.href} aria-current={active(item.href) ? "page" : undefined} class="block px-3 py-3 rounded-md text-sm text-ink hover:bg-accent-wash">
          {item.ru}
        </a>
      ))}
    </nav>
  </div>
</header>
<script>
  let navEvents: AbortController | undefined;
  function setupMobileMenu() {
    navEvents?.abort();
    navEvents = new AbortController();
    const { signal } = navEvents;
    const button = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const header = button?.closest('header');
    if (!button || !menu || !header) return;
    const scrollPosition = () => Math.max(0, Math.min(window.scrollY, document.documentElement.scrollHeight - innerHeight));
    let previousY = scrollPosition();
    let direction = 0;
    let distance = 0;
    const reveal = () => { header.dataset.scrollHidden = 'false'; };
    const syncScroll = () => {
      const y = scrollPosition();
      const delta = y - previousY;
      previousY = y;
      header.dataset.scrolled = String(y > 24);
      const keyboardFocus = header.contains(document.activeElement) && document.activeElement?.matches(':focus-visible');
      if (y <= 24 || header.dataset.menuOpen === 'true' || keyboardFocus) {
        reveal();
        direction = 0;
        distance = 0;
        return;
      }
      if (delta === 0) return;
      const nextDirection = Math.sign(delta);
      distance = nextDirection === direction ? distance + Math.abs(delta) : Math.abs(delta);
      direction = nextDirection;
      // Ignore tiny trackpad reversals and mobile overscroll bounce.
      if (direction < 0 && distance >= 8) reveal();
      else if (direction > 0 && distance >= 16 && y > 96) header.dataset.scrollHidden = 'true';
    };
    header.dataset.scrolled = String(previousY > 24);
    reveal();
    window.addEventListener('scroll', syncScroll, { passive: true, signal });
    header.addEventListener('focusin', reveal, { signal });
    function setOpen(open: boolean) {
      reveal();
      previousY = scrollPosition();
      direction = 0;
      distance = 0;
      header!.dataset.menuOpen = String(open);
      document.body.classList.toggle('nav-menu-open', open);
      document.querySelectorAll<HTMLElement>('main, .site-footer').forEach(el => el.inert = open);
      button!.setAttribute('aria-expanded', String(open));
      button!.setAttribute('aria-label', open ? 'Закрыть меню' : 'Меню');
      menu!.classList.toggle('hidden', !open);
      button!.querySelector('#menu-icon-open')?.classList.toggle('hidden', open);
      button!.querySelector('#menu-icon-close')?.classList.toggle('hidden', !open);
    }
    setOpen(false);
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'), { signal });
    menu.addEventListener('click', event => {
      if ((event.target as Element).closest('a')) setOpen(false);
    }, { signal });
    button.closest('header')?.addEventListener('keydown', event => {
      if (event.key === 'Escape') { setOpen(false); button.focus(); }
      if (event.key === 'Tab' && button.getAttribute('aria-expanded') === 'true') {
        const links = Array.from(header.querySelectorAll<HTMLElement>('a, button')).filter(el => el.getClientRects().length);
        const first = links[0], last = links[links.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
    }, { signal });
    window.addEventListener('resize', () => { if (innerWidth >= 1024) setOpen(false); }, { signal });
    document.addEventListener('astro:before-swap', () => setOpen(false), { once: true, signal });
  }
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
