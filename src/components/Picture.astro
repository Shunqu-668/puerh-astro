---
import { existsSync } from "node:fs";
import { join } from "node:path";
interface Props {
  src: string;
  alt: string;
  fallback?: string;
  class?: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
}

const { src, alt, fallback, class: className = "", loading = "lazy", width, height } = Astro.props;

const srcLower = src.toLowerCase();
const srcIsWebP = srcLower.endsWith(".webp");

const exists = (asset: string) => !asset.startsWith("/") || existsSync(join(process.cwd(), "public", asset));
const proposedWebp = srcIsWebP ? src : src.replace(/\.(jpg|jpeg|png)$/i, ".webp");
const webpSrc = exists(proposedWebp) ? proposedWebp : undefined;
const candidates = srcIsWebP ? [fallback, src.replace(/\.webp$/i, ".jpg"), src.replace(/\.webp$/i, ".png"), src] : [src];
const imgSrc = candidates.find((candidate): candidate is string => !!candidate && exists(candidate));
if (!imgSrc) throw new Error(`Missing public image: ${src}`);
---

<picture>
  {webpSrc && <source srcset={webpSrc} type="image/webp" />}
  <img
    src={imgSrc}
    alt={alt}
    class={className}
    loading={loading}
    decoding="async"
    width={width}
    height={height}
  />
</picture>
