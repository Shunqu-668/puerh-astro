---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { imageDimensions } from '../lib/image-dimensions';
import { responsivePhoto } from '../lib/product-images';
interface Props {
  src: string;
  alt: string;
  fallback?: string;
  class?: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
  sizes?: string;
  thumbnail?: boolean;
}

const { src, alt, fallback, class: className = "", loading = "lazy", width, height, sizes = '(min-width: 1280px) 384px, (min-width: 768px) 50vw, 100vw', thumbnail = false } = Astro.props;
const responsive = responsivePhoto(src, thumbnail);

const srcLower = src.toLowerCase();
const srcIsWebP = srcLower.endsWith(".webp");

const exists = (asset: string) => !asset.startsWith("/") || existsSync(join(process.cwd(), "public", asset));
const proposedWebp = srcIsWebP ? src : src.replace(/\.(jpg|jpeg|png)$/i, ".webp");
const webpSrc = exists(proposedWebp) ? proposedWebp : undefined;
const candidates = srcIsWebP ? [fallback, src.replace(/\.webp$/i, ".jpg"), src.replace(/\.webp$/i, ".png"), src] : [src];
const imgSrc = candidates.find((candidate): candidate is string => !!candidate && exists(candidate));
if (!imgSrc) throw new Error(`Missing public image: ${src}`);
const intrinsic = width && height ? { width, height } : await imageDimensions(webpSrc || imgSrc);
---

<picture>
  {!responsive && webpSrc && <source srcset={webpSrc} type="image/webp" />}
  <img
    src={responsive?.src || imgSrc}
    srcset={responsive?.srcset}
    sizes={responsive ? sizes : undefined}
    alt={alt}
    class={className}
    loading={loading}
    decoding="async"
    width={width || responsive?.width || intrinsic?.width}
    height={height || responsive?.height || intrinsic?.height}
  />
</picture>
