---
import Picture from "./Picture.astro";
import { type Product, typeLabels, shapeLabels, getProductImg } from "../data/products";
interface Props { product: Product }
const { product: p } = Astro.props;
---
<a href={`/catalog/product/${p.slug}/`} class="tea-card" data-product-card data-type={p.type} data-shape={p.shape} data-search={`${p.nameRu} ${p.nameEn} ${p.year} ${p.origin || ""}`.toLowerCase()}>
  <div class="tea-card-image">
    <Picture src={getProductImg(p)} alt={`${p.nameRu}, ${p.year}`} class="w-full h-full object-contain" />
    <span class="tea-card-year">{p.year}</span>
  </div>
  <div class="tea-card-body">
    <p class="eyebrow">{typeLabels[p.type].ru} · {shapeLabels[p.shape].ru}</p>
    <h3>{p.nameRu}</h3>
    <p lang="en" class="tea-card-english">{p.nameEn}</p>
    <div class="tea-card-bottom"><span><strong>{p.unitWeightGrams} г</strong> / шт.</span><span aria-hidden="true">Подробнее ↗</span></div>
  </div>
</a>
