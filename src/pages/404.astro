---
import Layout from "../components/Layout.astro";
import CTAButton from "../components/CTAButton.astro";
---

<Layout title="Страница не найдена" description="Эта страница не найдена. Перейдите в каталог пуэра или свяжитесь с PUERH DIRECT." canonicalURL="/404.html" noindex>
  <section class="py-24 md:py-32 bg-surface text-center">
    <div class="max-w-lg mx-auto px-4">
      <div class="text-8xl font-bold text-flame mb-4">404</div>
      <h1 class="text-2xl font-bold text-ink mb-4">
        <span>Страница не найдена</span>
      </h1>
      <p class="text-muted text-sm mb-8">
        <span>Запрошенная страница не существует или была перемещена.</span>
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
        <CTAButton href="/catalog/">Найти чай в каталоге</CTAButton>
        <CTAButton href="/contact/?topic=tea-selection#inquiry-form" variant="secondary">Помочь с выбором</CTAButton>
      </div>
      <div class="border-t border-line pt-8">
        <p class="text-xs text-gray-400 mb-4">
          <span>Продолжить знакомство</span>
        </p>
        <div class="flex flex-wrap gap-3 justify-center text-sm">
          <a href="/" class="text-muted hover:text-flame transition-colors py-3">Главная</a>
          <a href="/sample/" class="text-muted hover:text-flame transition-colors py-3">Образцы</a>
          <a href="/faq/" class="text-muted hover:text-flame transition-colors py-3">Вопросы перед заказом</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
