---
import { getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";
import CTAButton from "../../components/CTAButton.astro";
import { articlePaths } from "../../data/article-paths";
import "../../styles/editorial.css";
import "../../styles/article-reading.css";
import { articleMedia } from "../../data/article-media";
import { canonicalUrl, organizationId, jsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const result = await Promise.all(
    posts.map(async (post) => {
      const { Content, headings } = await render(post);
      return {
        params: { slug: post.id.replace(/\.md$/, "") },
        props: { post, Content, headings },
      };
    })
  );
  return result;
}

const { post, Content, headings } = Astro.props;
const slug = post.id.replace(/\.md$/, "");
const articleUrl = canonicalUrl(`/blog/${slug}/`);
const media = articleMedia[slug];
const articleImage = post.data.ogImage || canonicalUrl(media?.src || '/brand/social-card.png');
const next = articlePaths[slug] || { category: 'О пуэре', label: 'Посмотреть каталог', href: '/catalog/' };
const furtherReading = (await getCollection('blog')).filter(item => item.id !== post.id).slice(0, 2);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  '@id': `${articleUrl}#article`,
  url: articleUrl,
  mainEntityOfPage: { '@id': `${articleUrl}#webpage` },
  inLanguage: 'ru-RU',
  image: [articleImage],
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated || post.data.date).toISOString(),
  author: {
    "@type": "Organization",
    '@id': organizationId,
    name: "PUERH DIRECT",
    url: "https://puerhdirect.ru",
  },
  publisher: {
    "@type": "Organization",
    '@id': organizationId,
    name: "PUERH DIRECT",
    logo: {
      "@type": "ImageObject",
      url: "https://puerhdirect.ru/brand/logo.png",
    },
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonicalURL={`/blog/${slug}/`}
  ogImage={articleImage}
  ogType="article"
>
  <section class="reading-surface" data-theme="light">
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="reading-tools"><a href="/blog/">Блог / {next.category}</a><div><button type="button" data-reading-theme aria-pressed="false">Тёмный фон</button><button type="button" data-reading-size aria-pressed="false">A+ Крупнее текст</button></div></div>
    <header class="article-header"><h1>{post.data.title}</h1><p class="article-lead">{post.data.description}</p><div class="reading-byline"><span>Редакция PUERH DIRECT</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" })}</time>{post.data.updated && <span>Обновлено: <time datetime={post.data.updated.toISOString()}>{post.data.updated.toLocaleDateString("ru-RU")}</time></span>}</div></header>
    {media && <figure class:list={["article-hero", {paired: !!media.second}]}><div><img src={media.src} alt={media.alt} width="800" height="600" fetchpriority="high" />{media.second && <img src={media.second} alt="Шэн пуэр Иу 2018 — целый чайный блин" width="800" height="800" />}<span class="photo-credit" aria-hidden="true">PUERH DIRECT</span></div><figcaption>{media.caption}</figcaption></figure>}
    <div class="reading-layout"><aside class="reading-toc"><strong>В этой статье</strong><nav aria-label="Содержание статьи">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside><div class="reading-content">
      <details class="article-toc"><summary>В этой статье</summary><nav aria-label="Мобильное содержание">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>
      <article class="article-body"><Content /></article>
      <div class="article-next"><h2>От чтения к выбору</h2><p>Можно начать с вопроса. Точный объём пока не нужен.</p><CTAButton href={next.href}>{next.label}</CTAButton><a class="article-help" href="/contact/?topic=tea-selection#inquiry-form">Помочь с выбором чая →</a></div>
      <section class="article-further" aria-label="Ещё по теме"><h2>Полезно перед закупкой</h2>{furtherReading.map(item => <a href={`/blog/${item.id}/`}>{item.data.title}<span aria-hidden="true">→</span></a>)}</section>
      <a class="reading-back" href="/blog/">Все статьи →</a>
    </div></div>
  </section>
  <script>import '../../scripts/article-reading';</script>

  <script slot="head" type="application/ld+json" set:html={jsonLd(articleSchema)}></script>
</Layout>
