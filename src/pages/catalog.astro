---
import Layout from "../components/Layout.astro";
import CoverHero from "../components/CoverHero.astro";
import CatalogBrowser from "../components/CatalogBrowser.astro";
import CategoryNav from "../components/CategoryNav.astro";
import CatalogSchema from '../components/CatalogSchema.astro';
import { products } from "../data/products";
---

<Layout
  title="Каталог пуэра — шу и шэн для бизнеса"
  description="Шу и шэн пуэр оптом из Китая. Выберите чай и запросите цену под свой объём."
  ogImage="https://puerhdirect.ru/images/images/catalog-header.webp"
  canonicalURL="/catalog/"
>
  <CatalogSchema products={products} path="/catalog/" />
  <CoverHero
    compact
    titleRu="Каталог пуэра"
    titleEn="ВЫБОР ЧАЯ"
    subtitleRu="Шу и шэн из Китая. Количество по вашему запросу."
    bgImage="/images/images/catalog-header.webp"
  />

  <section class="catalog-page-content py-12 md:py-16 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="catalog-breadcrumb text-sm text-gray-400 mb-8" aria-label="Хлебные крошки">
        <a href="/" class="hover:text-flame transition-colors">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-muted">Каталог</span>
      </nav>

      <!-- Category quick links -->
      <CategoryNav />

      <CatalogBrowser products={products} />
    </div>
  </section>
</Layout>
