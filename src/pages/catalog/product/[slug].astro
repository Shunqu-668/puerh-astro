---
import Layout from "../../../components/Layout.astro";
import CTAButton from "../../../components/CTAButton.astro";
import ProductImage from "../../../components/ProductImage.astro";
import ProductCard from "../../../components/ProductCard.astro";
import SelectionHelp from "../../../components/SelectionHelp.astro";
import { catalogSpecs } from "../../../data/catalog-specs";
import { products, typeLabels, shapeLabels, getProductImg } from "../../../data/products";
import { teaProfiles } from "../../../data/tea-profiles";
import galleryData from "../../../data/product-gallery.json";
import { canonicalUrl, jsonLd } from '../../../lib/seo';

export function getStaticPaths() {
  return products.map(p => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const p = products.find(x => x.slug === slug);
if (!p) return Astro.redirect("/404");
const spec = catalogSpecs.get(p.slug)!;
const related = products.filter(item => item.slug !== p.slug && item.type === p.type)
  .sort((a, b) => Number(b.shape === p.shape) - Number(a.shape === p.shape) || Math.abs(a.year - p.year) - Math.abs(b.year - p.year))
  .slice(0, 4);
const profile = teaProfiles[p.slug];
const productUrl = `/catalog/product/${p.slug}/`;
const productImg = getProductImg(p);
const detailImages = (galleryData as Record<string, string[]>)[p.slug] || [];
const categoryUrl = `/catalog/${p.type === "raw" ? "raw-puerh" : "ripe-puerh"}/`;
const shortDescription = `${p.nameRu}, ${p.year}: ${typeLabels[p.type].ru.toLowerCase()}, ${spec.grams} г. ${profile.summary} Оптовая цена и наличие — по запросу; доступны платные образцы.`;
const telegramHref = `https://t.me/sqvivi777?text=${encodeURIComponent(`Здравствуйте! Интересует ${p.nameRu}, ${p.year}, ${spec.grams} г.\nhttps://puerhdirect.ru${productUrl}`)}`;
const breadcrumbSchema = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "PUERH DIRECT", item: "https://puerhdirect.ru/" },
    { "@type": "ListItem", position: 2, name: "Каталог", item: "https://puerhdirect.ru/catalog/" },
    { "@type": "ListItem", position: 3, name: typeLabels[p.type].ru, item: `https://puerhdirect.ru${categoryUrl}` },
    { "@type": "ListItem", position: 4, name: p.nameRu, item: canonicalUrl(productUrl) },
  ],
};
const productSchema = {
  "@context": "https://schema.org", "@type": "Product",
  '@id': `${canonicalUrl(productUrl)}#product`,
  url: canonicalUrl(productUrl),
  mainEntityOfPage: { '@id': `${canonicalUrl(productUrl)}#webpage` },
  name: `${p.year} ${p.nameRu}`,
  description: shortDescription,
  image: [productImg, ...detailImages].map(image => `https://puerhdirect.ru${image}`),
  category: typeLabels[p.type].ru,
  ...(profile.maker ? { manufacturer: { '@type': 'Organization', name: profile.maker.split(' · ')[0] } } : {}),
  weight: { '@type': 'QuantitativeValue', value: spec.grams, unitCode: 'GRM' },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Год выпуска', value: p.year },
    { '@type': 'PropertyValue', name: 'Форма', value: shapeLabels[p.shape].ru },
  ],
};
---
<Layout title={`${p.nameRu}, ${p.year} — ${typeLabels[p.type].ru}`}
  description={shortDescription} ogImage={`https://puerhdirect.ru${productImg}`} canonicalURL={productUrl}>
  <section class="py-8 md:py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-muted mb-8 flex flex-wrap gap-2" aria-label="Хлебные крошки">
        <a href="/catalog/" class="hover:text-acid">Каталог</a><span>/</span>
        <a href={categoryUrl} class="hover:text-acid">{typeLabels[p.type].ru}</a>
      </nav>
      <div class="product-layout grid md:grid-cols-2 gap-8 lg:gap-12 items-start">
        <div class="product-heading">
          <div class="product-meta mb-5">
            <span class="text-sm font-bold text-gray-950 bg-acid px-3 py-1">{p.year}</span>
            <span class="text-sm text-soft bg-raised px-3 py-1">{typeLabels[p.type].ru}</span>
            <span class="text-sm text-soft bg-raised px-3 py-1">{shapeLabels[p.shape].ru}</span>
          </div>
          <h1 class="text-3xl lg:text-4xl font-bold text-ink mb-3 leading-tight">{p.nameRu}</h1>
          <p class="product-maker">{profile.maker ? `Фабрика ${profile.maker}` : p.nameEn}</p>
        </div>
        <ProductImage src={productImg} alt={`${p.year} · ${p.nameRu}`} details={detailImages} />
        <div class="product-details">
          <div class="product-character">
            {profile.notes.length > 0 && <ul class="tea-tasting-notes" aria-label="Вкус и аромат">{profile.notes.map(note => <li>{note}</li>)}</ul>}
            <p>{profile.summary}</p>
            <p class="product-occasion">{profile.occasion}</p>
          </div>
          <dl class="product-specs">
            <div><dt>Вид чая</dt><dd>{typeLabels[p.type].ru}</dd></div>
            <div><dt>Год выпуска</dt><dd>{p.year}</dd></div>
            <div><dt>Форма</dt><dd>{shapeLabels[p.shape].ru}</dd></div>
            <div><dt>Вес единицы</dt><dd>{spec.grams} г</dd></div>
            <div><dt>В коробке</dt><dd>{spec.cartonUnits} шт.</dd></div>
          </dl>
          <div class="product-purchase">
            <h2 class="purchase-title">Цена по запросу</h2>
            <p>Без фиксированного минимума. Цена зависит от чая и количества.</p>
            <div class="flex flex-wrap gap-3">
              <CTAButton href={`/contact/?product=${encodeURIComponent(p.slug)}&tea=${encodeURIComponent(p.nameRu)}#inquiry-form`}>Запросить цену</CTAButton>
              <a class="inline-flex items-center px-5 py-3 border border-line-strong rounded font-bold text-sm hover:border-acid" href={`/sample/?product=${encodeURIComponent(p.slug)}`}>Выбрать образец</a>
            </div>
            <p class="purchase-followup">Имя и телефон — всё, что нужно для первого запроса.</p>
            <a class="product-direct-chat" href={telegramHref} target="_blank" rel="noopener noreferrer">Спросить об этом чае в Telegram ↗</a>
          </div>
          <dl class="grid grid-cols-2 gap-5 border-t border-line pt-5 text-sm">
            <div><dt class="text-muted mb-2">Образцы</dt><dd class="text-ink font-bold">Платные</dd></div>
            <div><dt class="text-muted mb-2">Доставка</dt><dd class="text-ink font-bold">По согласованию</dd></div>
          </dl>
          <nav class="product-practical-links" aria-label="Условия закупки"><a href="/faq/#batch-details">Наличие и упаковка партии →</a><a href="/compliance/">Документы к заказу →</a></nav>
          <p class="catalog-source-note">Вкус описан по нашему каталогу. Оцените чай на образце; наличие и фасовку партии подтвердим в предложении.</p>
        </div>
      </div>
      <section class="product-related" aria-labelledby="related-heading">
        <h2 id="related-heading">Другие варианты</h2>
        <div class="catalog-grid">{related.map(item => <ProductCard product={item} />)}</div>
      </section>
      <SelectionHelp />
    </div>
  </section>
  <script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={jsonLd(productSchema)}></script>
</Layout>
