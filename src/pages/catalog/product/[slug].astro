---
import Layout from "../../../components/Layout.astro";
import Picture from "../../../components/Picture.astro";
import { products, typeLabels, shapeLabels, getProductImg } from "../../../data/products";
import productDescriptions from "../../../data/product-descriptions.json";
export function getStaticPaths() { return products.map(p => ({ params: { slug: p.slug } })); }
const p = products.find(x => x.slug === Astro.params.slug)!;
const desc = productDescriptions[p.slug] || {};
const productUrl = `/catalog/product/${p.slug}/`;
const quoteUrl = `/contact/?product=${encodeURIComponent(p.slug)}&tea=${encodeURIComponent(p.nameRu)}#inquiry-form`;
const description = `${p.nameRu}, ${p.year}. ${typeLabels[p.type].ru}, ${shapeLabels[p.shape].ru.toLowerCase()}, ${p.unitWeightGrams} г/шт. Запросите цену и наличие для вашего объёма. Параметры партии уточняются в предложении.`;
const schema = { "@context": "https://schema.org", "@type": "Product", name: `${p.nameRu}, ${p.year}`, description, image: `https://puerhdirect.ru${getProductImg(p)}`, sku: p.slug, category: typeLabels[p.type].ru };
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Каталог", item: "https://puerhdirect.ru/catalog/" },
  { "@type": "ListItem", position: 2, name: p.nameRu, item: `https://puerhdirect.ru${productUrl}` }
]};
---
<Layout title={`${p.nameRu} ${p.year} — ${p.unitWeightGrams} г`} description={description} canonicalURL={productUrl} ogImage={`https://puerhdirect.ru${getProductImg(p)}`}>
  <section class="section-shell product-section">
    <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/catalog/">Каталог</a><span>/</span><a href={`/catalog/${p.type}-puerh/`}>{typeLabels[p.type].ru}</a><span>/</span><span>{p.nameRu}</span></nav>
    <div class="product-layout">
      <div class="product-visual"><div class="product-photo"><Picture src={getProductImg(p)} alt={`${p.nameRu}, ${p.year}`} class="w-full h-full object-contain" loading="eager" /></div><p class="photo-caption">{p.year} / {typeLabels[p.type].ru} / {shapeLabels[p.shape].ru}</p></div>
      <div class="product-summary">
        <p class="eyebrow">{typeLabels[p.type].ru} · {p.year}</p>
        <h1 class="display-title">{p.nameRu}</h1>
        <p lang="en" class="product-english">{p.nameEn}</p>
        <dl class="product-specs">
          <div><dt>Вес одной штуки</dt><dd><span data-unit-weight>{p.unitWeightGrams}</span> г</dd></div>
          <div><dt>Упаковка по каталогу</dt><dd>{p.unitsPerCarton} шт. / коробка</dd></div>
          <div><dt>Форма</dt><dd>{shapeLabels[p.shape].ru}</dd></div>
          <div><dt>Год по каталогу</dt><dd>{p.year}</dd></div>
        </dl>
        <p class="spec-note">Параметры указаны по каталогу поставщика. Актуальную партию и упаковку подтвердим в предложении. Заказ не обязательно кратен коробке.</p>
        <div class="quantity-panel" data-quantity-panel data-weight={p.unitWeightGrams}>
          <label for="quote-quantity">Какое количество вас интересует?</label>
          <div class="quantity-row"><input id="quote-quantity" type="number" min="0.001" max="1000000" step="any" inputmode="decimal" placeholder="Количество" aria-describedby="quantity-result" /><select id="quote-unit" aria-label="Единица количества"><option value="pieces">шт.</option><option value="kg">кг</option></select><output id="quantity-result" aria-live="polite">Укажите объём</output></div>
          <p class="quantity-hint">Расчёт по весу чая, без упаковки. Это запрос, а не оформление заказа.</p>
          <a href={quoteUrl} data-quote-link class="button primary">Запросить цену <span aria-hidden="true">↗</span></a>
          <a href={`/sample/?product=${encodeURIComponent(p.slug)}`} class="sample-text-link">Сначала заказать платный образец →</a>
        </div>
        <p class="product-terms">Без фиксированного минимального объёма. Доставку и передачу экспедитору согласуем отдельно.</p>
      </div>
    </div>
    <div class="product-details">
      <div><p class="eyebrow">ЗНАКОМСТВО С ЧАЕМ</p><h2>Описание и детали</h2><p class="spec-note">Описание поставщика помогает сориентироваться. Вкус оцените по образцу, происхождение и условия хранения уточните для выбранной партии.</p></div>
      <div class="product-copy">
        <p>{desc.descRu || `${typeLabels[p.type].ru} в форме «${shapeLabels[p.shape].ru.toLowerCase()}». Запросите образец, сведения о партии и условия поставки.`}</p>
        {(desc.descEn || desc.descCn) && <details><summary>Описание на английском и китайском</summary>{desc.descEn && <p lang="en">{desc.descEn}</p>}{desc.descCn && <p lang="zh">{desc.descCn}</p>}</details>}
        <a href="/blog/kak-vybrat-postavshika-puera-v-kitae/" class="text-link">Что уточнить у поставщика до закупки ↗</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
</Layout>
<script>
 const initialized = new WeakSet<HTMLElement>();
 function setupQuantity() {
  document.querySelectorAll<HTMLElement>('[data-quantity-panel]').forEach(panel => {
   if (initialized.has(panel)) return;
   initialized.add(panel);
   const input = panel.querySelector<HTMLInputElement>('input')!;
   const unit = panel.querySelector<HTMLSelectElement>('select')!;
   const output = panel.querySelector<HTMLOutputElement>('output')!;
   const link = panel.querySelector<HTMLAnchorElement>('[data-quote-link]')!;
   const original = link.getAttribute('href')!;
   const weight = Number(panel.dataset.weight);
   const format = (n: number) => new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 3 }).format(n);
   const update = () => {
    input.step = unit.value === 'pieces' ? '1' : '0.001';
    input.min = unit.value === 'pieces' ? '1' : '0.001';
    const qty = input.valueAsNumber;
    const valid = Number.isFinite(qty) && input.validity.valid;
    link.setAttribute('href', original);
    if (!input.value) { output.textContent = 'Укажите объём'; return; }
    if (!valid) { output.textContent = unit.value === 'pieces' ? 'Укажите целое число штук' : 'Проверьте количество'; return; }
    output.textContent = unit.value === 'pieces' ? `≈ ${format(qty * weight / 1000)} кг нетто` : `≈ ${format(qty * 1000 / weight)} шт. · ориентир`;
    const url = new URL(original, location.origin);
    url.searchParams.set('quantity', String(qty)); url.searchParams.set('unit', unit.value);
    link.href = url.pathname + url.search + url.hash;
   };
   input.addEventListener('input', update); unit.addEventListener('change', update);
   update();
  });
 }
 setupQuantity(); document.addEventListener('astro:page-load', setupQuantity);
</script>
