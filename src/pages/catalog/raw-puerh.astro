---
import Layout from "../../components/Layout.astro";
import CoverHero from "../../components/CoverHero.astro";
import CatalogBrowser from "../../components/CatalogBrowser.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import CatalogSchema from '../../components/CatalogSchema.astro';
import CategoryGuide from '../../components/CategoryGuide.astro';
import { products } from "../../data/products";

const rawProducts = products.filter(p => p.type === "raw");
---

<Layout
  title="Шэн пуэр — каталог для бизнеса"
  description="Шэн пуэр оптом. Выбор по названию, году и форме. Наличие и условия уточним при запросе."
  ogImage="https://puerhdirect.ru/images/images/2.webp"
  canonicalURL="/catalog/raw-puerh/"
>
  <CatalogSchema products={rawProducts} path="/catalog/raw-puerh/" />
  <CoverHero
    compact
    titleRu="Шэн пуэр"
    titleEn="КАТАЛОГ ЧАЯ"
    subtitleRu="Шэн пуэр из каталога. Выберите чай для вашего бизнеса."
    bgImage="/images/images/2.webp"
  />
  <section class="catalog-page-content py-12 md:py-16 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="catalog-breadcrumb text-sm text-gray-400 mb-8" aria-label="Хлебные крошки">
        <a href="/" class="hover:text-flame transition-colors">Главная</a>
        <span class="mx-2">/</span>
        <a href="/catalog/" class="hover:text-flame transition-colors">Каталог</a>
        <span class="mx-2">/</span>
        <span class="text-muted">Шэн пуэр</span>
      </nav>
      <CategoryNav />
      <CatalogBrowser products={rawProducts} fixedType="raw" />
      <CategoryGuide type="raw" />
    </div>
  </section>
</Layout>
