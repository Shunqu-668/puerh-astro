---
import Layout from "../../components/Layout.astro";
import CoverHero from "../../components/CoverHero.astro";
import CatalogBrowser from "../../components/CatalogBrowser.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import CatalogSchema from '../../components/CatalogSchema.astro';
import CategoryGuide from '../../components/CategoryGuide.astro';
import { products } from "../../data/products";

const ripeProducts = products.filter(p => p.type === "ripe");
---

<Layout
  title="Шу пуэр — каталог для бизнеса"
  description="Шу пуэр оптом. Выбор по названию, году и форме. Наличие и условия уточним при запросе."
  ogImage="https://puerhdirect.ru/images/images/1.webp"
  canonicalURL="/catalog/ripe-puerh/"
>
  <CatalogSchema products={ripeProducts} path="/catalog/ripe-puerh/" />
  <CoverHero
    compact
    titleRu="Шу пуэр"
    titleEn="КАТАЛОГ ЧАЯ"
    subtitleRu="Шу пуэр из каталога. Выберите чай для вашего бизнеса."
    bgImage="/images/images/1.webp"
  />
  <section class="catalog-page-content py-12 md:py-16 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="catalog-breadcrumb text-sm text-gray-400 mb-8" aria-label="Хлебные крошки">
        <a href="/" class="hover:text-flame transition-colors">Главная</a>
        <span class="mx-2">/</span>
        <a href="/catalog/" class="hover:text-flame transition-colors">Каталог</a>
        <span class="mx-2">/</span>
        <span class="text-muted">Шу пуэр</span>
      </nav>
      <CategoryNav />
      <CatalogBrowser products={ripeProducts} fixedType="ripe" />
      <CategoryGuide type="ripe" />
    </div>
  </section>
</Layout>
