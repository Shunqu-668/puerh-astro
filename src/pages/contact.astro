---
import Layout from "../components/Layout.astro";
---
<Layout title="Обсудить закупку — контакты и запрос цены" description="Укажите чай, количество и удобный способ связи. Подготовим предложение; доставку и передачу экспедитору согласуем отдельно." canonicalURL="/contact/">
 <section class="section-shell contact-section">
  <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><span>Контакты</span></nav>
  <p class="eyebrow">НАЧНЁМ С ВАШЕЙ ЗАДАЧИ</p><h1 class="display-title">Обсудим закупку.</h1>
  <div class="contact-layout">
   <aside class="contact-aside"><p class="contact-lead">Расскажите, какой чай нужен вашему бизнесу. Количество, упаковку и доставку обсудим в предложении.</p><a href="https://t.me/sqvivi777" target="_blank" rel="noopener noreferrer" class="contact-method"><span>Быстрее начать в Telegram</span><strong>@sqvivi777 ↗</strong></a><a href="https://wa.me/8613728005309" target="_blank" rel="noopener noreferrer" class="contact-method"><span>WhatsApp</span><strong>+86 137 2800 5309 ↗</strong></a><a href="mailto:wholesale@puerhdirect.ru" class="contact-method"><span>Электронная почта</span><strong>wholesale@puerhdirect.ru</strong></a><div class="contact-method"><span>WeChat</span><strong>puerhdirect</strong></div><p class="spec-note">Нет готового списка? <a href="/catalog/" class="text-link">Посмотрите каталог</a> или <a href="/sample/" class="text-link">начните с образцов</a>.</p></aside>
   <div class="contact-form-panel"><h2>Ваш запрос</h2><p class="spec-note">Обязательны имя и способ связи. Остальное можно уточнить позже.</p>
        <form id="inquiry-form" data-inquiry-form action={import.meta.env.DEV ? "#" : "https://api.web3forms.com/submit"} method="POST" class="inquiry-fields space-y-6">
          <input type="hidden" name="access_key" value="a1ae9002-3a5a-473b-8030-7559a8252650" />
          <input type="hidden" name="from_name" value="PUERH DIRECT — Контакты | Contact" />
          <input type="hidden" name="subject" value="Новый запрос с puerhdirect.ru" />
          <input type="hidden" name="redirect" value="false" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-1.5">
                Имя <span class="text-orange-500">*</span>

              </label>
              <input type="text" id="contact-name" name="name" maxlength="120" autocomplete="name" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition text-sm" placeholder="Александр">
            </div>
            <div>
              <label for="contact-contact" class="block text-sm font-medium text-gray-700 mb-1.5">
                Телефон / Контакт <span class="text-orange-500">*</span>

              </label>
              <input type="text" id="contact-contact" name="contact" maxlength="120" autocomplete="off" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition text-sm" placeholder="Telegram / WhatsApp / +7...">
            </div>
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-medium text-gray-700 mb-1.5">
              Электронная почта

              <span class="text-gray-400 text-xs ml-1">(необязательно)</span>
            </label>
            <input type="email" id="contact-email" name="email" maxlength="254" autocomplete="email" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition text-sm" placeholder="your@email.com">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="contact-product_interest" class="block text-sm font-medium text-gray-700 mb-1.5">
                Интересующий продукт

              </label>
              <select id="contact-product_interest" name="product_interest" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition text-sm text-gray-700">
                <option value="">Выберите из списка | Choose from list</option>
                <option value="shu-puerh">Шу Пуэр | Ripe Puerh</option>
                <option value="sheng-puerh">Шэн Пуэр | Raw Puerh</option>
                <option value="aged-puerh">Выдержанный пуэр (до 2005 г.) | Aged Puerh (pre-2005)</option>
                <option value="teaware">Чайная посуда | Teaware</option>
                <option value="private-label">Приватная марка | Private Label</option>
                <option value="other">Другое | Other</option>
              </select>
            </div>
            <div>
              <label for="contact-order_volume" class="block text-sm font-medium text-gray-700 mb-1.5">
                Предполагаемый объём

              </label>
              <input type="text" id="contact-order_volume" name="order_volume" maxlength="100" class="form-input" placeholder="Например: 3 кг или 12 шт." />
            </div>
          </div>

          <div>
            <label for="product-requested" class="form-label">Конкретный чай <span lang="en">| Selected tea (optional)</span></label>
            <input id="product-requested" name="product_requested" type="text" maxlength="200" class="form-input" placeholder="Название чая или ссылка на продукт" />
            <input type="hidden" name="product_sku" />
<input type="hidden" name="product_unit_weight_g" />
<p data-product-context class="spec-note" hidden></p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="destination" class="form-label">Город назначения <span lang="en">| City (optional)</span></label>
              <input id="destination" name="destination" type="text" maxlength="120" class="form-input" autocomplete="address-level2" />
            </div>
            <div>
              <label for="forwarder" class="form-label">Ваш экспедитор <span lang="en">| Forwarder (optional)</span></label>
              <select id="forwarder" name="forwarder" class="form-input">
                <option value="">Можно уточнить позже | Decide later</option>
                <option value="own">Есть свой экспедитор | I have a forwarder</option>
                <option value="undecided">Пока не определён | Not yet arranged</option>
              </select>
            </div>
          </div>
          <p class="text-sm text-gray-600">Доставку и передачу вашему экспедитору согласуем отдельно. Наличие экспедитора не обязательно для запроса.</p>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">
              Тип запроса <span class="text-orange-500">*</span>

            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-300 cursor-pointer hover:border-orange-400 transition has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50">
                <input type="radio" name="inquiry_type" value="wholesale" checked required class="w-4 h-4 text-orange-500 focus:ring-orange-500">
                <div>
                  <span class="text-sm font-medium text-gray-800">Оптовый заказ</span>
                  <span class="block text-xs text-gray-400">Wholesale Order</span>
                </div>
              </label>
              <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-300 cursor-pointer hover:border-orange-400 transition has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50">
                <input type="radio" name="inquiry_type" value="private_label" class="w-4 h-4 text-orange-500 focus:ring-orange-500">
                <div>
                  <span class="text-sm font-medium text-gray-800">Приватная марка / Изготовление под заказ</span>
                  <span class="block text-xs text-gray-400">Private Label / Customization</span>
                </div>
              </label>
              <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-300 cursor-pointer">
                <input type="radio" name="inquiry_type" value="paid_samples" class="w-4 h-4" />
                <span>Платные образцы <span class="block text-xs text-gray-500" lang="en">Paid samples</span></span>
              </label>
            </div>
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-1.5">
              Детали запроса

            </label>
            <textarea id="contact-message" name="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition text-sm resize-y" placeholder="Опишите, какой чай вас интересует, желаемый объём, бюджет...&#10;Describe what tea you're interested in, desired volume, budget..."></textarea>
          </div>

          <div class="text-center pt-2">
            <button type="submit" id="submit-btn" aria-describedby="form-preview" class="button primary">
              Отправить запрос ↗
            </button>
          </div>

          <p id="form-preview" class="hidden text-sm text-amber-900 bg-amber-50 border border-amber-200 rounded-lg p-4" role="status" tabindex="-1"></p>
          <div id="form-success" role="status" tabindex="-1" class="hidden text-center p-6 bg-green-50 rounded-xl border border-green-200">
            <p class="text-green-700 font-semibold text-lg">Запрос отправлен! | Inquiry Sent!</p>
            <p class="text-green-600 text-sm mt-1">Мы свяжемся с вами в ближайшее время. | We'll contact you shortly.</p>
          </div>

          <div id="form-error" role="alert" tabindex="-1" class="hidden text-center p-6 bg-red-50 rounded-xl border border-red-200">
            <p class="text-red-700 font-semibold">Ошибка отправки | Submission Error</p>
            <p class="text-red-600 text-sm mt-1">Пожалуйста, попробуйте ещё раз или напишите нам в Telegram. | Please try again or contact us on Telegram.</p>
          </div>
        </form>
   </div>
  </div>
 </section>
</Layout>
<script>import "../scripts/inquiry";</script>
