---
import Layout from "../components/Layout.astro";
import { products } from "../data/products";
import { productInquiryLabel } from "../data/catalog-specs";
import { inquiryTopics } from "../data/inquiry-topics";
const catalogue = products.map(product => ({ slug: product.slug, name: productInquiryLabel(product) }));
---
<Layout
  title="Обсудим ваш чай — Контакты"
  description="Пуэр для вашего бизнеса. Оставьте контакт или напишите в Telegram. Поможем с выбором, обсудим цену и условия."
  canonicalURL="/contact/"
>
  <section class="contact-page">
    <div class="contact-layout">
      <div class="contact-intro">
        <a href="/catalog/" class="contact-back">← Каталог</a>
        <p class="contact-eyebrow">PUERH DIRECT · НА СВЯЗИ</p>
        <h1>Обсудим<br /> ваш чай.</h1>
        <p class="contact-lead">Ваша команда по чаю в Гуанчжоу. Подбор пуэра, образцы или своя серия.</p>
        <p class="contact-note">Количество и доставку обсудим в переписке.</p>
        <a class="contact-quick-chat" href="https://t.me/sqvivi777" target="_blank" rel="noopener noreferrer">Или сразу в Telegram ↗</a>
      </div>

      <form id="inquiry-form" data-inquiry-form data-product-catalog={JSON.stringify(catalogue)} data-inquiry-topics={JSON.stringify(inquiryTopics)}
        action={import.meta.env.DEV ? "#" : "https://api.web3forms.com/submit"} method="POST" class="contact-form">
        <input type="hidden" name="access_key" value="a1ae9002-3a5a-473b-8030-7559a8252650" />
        <input type="hidden" name="from_name" value="PUERH DIRECT — Контакты" />
        <input type="hidden" name="subject" value="Новый запрос с puerhdirect.ru" />
        <input type="hidden" name="redirect" value="false" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" />

        <div id="selected-product" class="selected-product hidden">
          <div><span>Вас интересует</span><p id="selected-product-name"></p></div>
          <button type="button" id="clear-product" aria-label="Убрать выбор">×</button>
        </div>
        <input type="hidden" name="product_requested" />
        <input type="hidden" name="product_sku" />
        <input type="hidden" name="inquiry_topic" />

        <div>
          <label for="contact-name" class="form-label">Имя <span aria-hidden="true">*</span></label>
          <input type="text" id="contact-name" name="name" maxlength="120" autocomplete="name"
            required class="form-input" placeholder="Как к вам обращаться?" />
        </div>
        <div>
          <label for="contact-contact" class="form-label">Телефон <span aria-hidden="true">*</span></label>
          <input type="tel" id="contact-contact" name="contact" maxlength="40" autocomplete="tel" inputmode="tel"
            required class="form-input" placeholder="+7 …" aria-describedby="contact-hint" />
          <p id="contact-hint" class="contact-hint">Укажите номер с кодом страны.</p>
        </div>
        <div>
          <label for="contact-email" class="form-label">Email <span>Необязательно</span></label>
          <input type="email" id="contact-email" name="email" maxlength="254" autocomplete="email" inputmode="email"
            autocapitalize="none" spellcheck="false" class="form-input" placeholder="name@example.com" />
        </div>
        <div>
          <label for="contact-message" class="form-label">Что вас интересует? <span>Необязательно</span></label>
          <textarea id="contact-message" name="message" maxlength="2000" rows="3" class="form-input"
            placeholder="Например: помогите выбрать шу пуэр для магазина"></textarea>
        </div>
        <button type="submit" id="submit-btn" aria-describedby="form-preview" class="contact-submit">Отправить запрос <span aria-hidden="true">↗</span></button>
        <p class="contact-privacy">Используем контакт, чтобы ответить на ваш запрос. <a href="/privacy/">Конфиденциальность</a></p>

        <p id="form-preview" class="hidden contact-status contact-preview" role="status" tabindex="-1"></p>
        <div id="form-success" class="hidden contact-status contact-success" role="status" tabindex="-1">
          <p><strong>Запрос отправлен.</strong></p><p>Ответим по указанному контакту.</p>
        </div>
        <div id="form-error" class="hidden contact-status contact-error" role="alert" tabindex="-1">
          <p><strong>Не удалось отправить запрос.</strong></p>
          <p>Попробуйте ещё раз или <a href="https://t.me/sqvivi777" target="_blank" rel="noopener noreferrer">напишите в Telegram</a>.</p>
        </div>
        <noscript><p class="contact-status">Для формы нужен JavaScript. <a href="https://t.me/sqvivi777">Напишите нам в Telegram</a>.</p></noscript>
      </form>

      <aside class="contact-chat">
        <div class="contact-expectation"><h2>Что дальше?</h2><p>Уточним ваш запрос и обсудим варианты. Цену и условия согласуем до заказа.</p></div>
        <h2>Удобнее в Telegram?</h2>
        <a href="https://t.me/sqvivi777" target="_blank" rel="noopener noreferrer" class="contact-telegram">Написать в Telegram <span aria-hidden="true">↗</span></a>
        <p>@sqvivi777 · Можно сразу задать вопрос.</p>
        <div class="contact-other">
          <a href="https://wa.me/8613728005309" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
          <span>WeChat: puerhdirect</span>
        </div>
      </aside>
    </div>
  </section>
</Layout>
<script>
  import "../scripts/inquiry";
</script>
<style>
  .contact-page { padding: 60px 24px 88px; }
  .contact-layout { max-width: 1100px; margin: auto; display: grid; grid-template-columns: 1fr 1.1fr; grid-template-areas: "intro form" "chat form"; column-gap: 72px; row-gap: 36px; align-items: start; }
  .contact-intro { grid-area: intro; }
  .contact-back { font-size: .8rem; color: #afb4bd; }
  .contact-back:hover { color: #e8ad73; }
  .contact-eyebrow { color: #e8ad73; font-size: .7rem; letter-spacing: .12em; margin-top: 36px; }
  h1 { font-size: clamp(2.1rem,4vw,3.3rem); font-weight: 700; line-height: 1.08; letter-spacing: -.025em; margin: 18px 0 24px; }
  .contact-lead { color: #d6d8dc; max-width: 330px; font-size: 1rem; line-height: 1.65; }
  .contact-note { color: #afb4bd; font-size: .85rem; margin-top: 12px; line-height: 1.65; }
  .contact-expectation { border-left: 2px solid #74543a; padding-left: 16px; margin-bottom: 28px; max-width: 350px; }
  .contact-expectation h2 { font-size: .85rem; color: #e8ad73; font-weight: 600; margin-bottom: 8px; }
  .contact-expectation p { font-size: .8rem; color: #afb4bd; line-height: 1.7; }
  .contact-quick-chat { display: inline-flex; align-items: center; min-height: 44px; color: #e8ad73; font-size: .85rem; text-decoration: underline; text-underline-offset: 4px; margin-top: 8px; }
  .contact-form { grid-area: form; padding: 32px; margin-top: 36px; border: 1px solid #34373c; border-radius: 8px; background: #191b1e; display: flex; flex-direction: column; gap: 22px; min-width: 0; scroll-margin-top: 90px; }
  .form-label { margin-bottom: 10px; }
  .form-label span { display: inline-block; font-size: .75rem; margin-left: 5px; }
  .form-input { min-height: 48px; }
  textarea { resize: vertical; }
  .contact-hint { font-size: .75rem; color: #afb4bd; margin-top: 9px; }
  .contact-submit { min-height: 50px; border-radius: 4px; padding: 12px 18px; display: flex; justify-content: space-between; align-items: center; font-weight: 650; font-size: .9rem; cursor: pointer; }
  .contact-privacy { color: #afb4bd; font-size: .7rem; line-height: 1.7; margin-top: -8px; }
  .contact-privacy a { text-decoration: underline; text-underline-offset: 3px; }
  .contact-chat { grid-area: chat; border-top: 1px solid #34373c; padding-top: 24px; }
  .contact-chat h2 { font-size: 1rem; font-weight: 600; margin-bottom: 14px; }
  .contact-telegram { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; border: 1px solid #61666e; border-radius: 4px; font-size: .85rem; min-height: 48px; }
  .contact-telegram:hover { border-color: #e8ad73; background: #191b1e; }
  .contact-chat > p { color: #afb4bd; font-size: .75rem; margin-top: 10px; }
  .contact-other { display: flex; flex-wrap: wrap; gap: 12px 22px; font-size: .75rem; color: #afb4bd; margin-top: 24px; }
  .contact-other a { text-decoration: underline; text-underline-offset: 4px; }
  .selected-product { border-bottom: 1px solid #34373c; padding-bottom: 18px; gap: 8px; align-items: start; }
  .selected-product:not(.hidden) { display: flex; }
  .selected-product > div { flex: 1; min-width: 0; }
  .selected-product span { color: #afb4bd; font-size: .7rem; }
  .selected-product p { color: #e8ad73; font-size: .9rem; line-height: 1.5; margin-top: 5px; overflow-wrap: anywhere; }
  .selected-product button { min-width: 44px; min-height: 44px; border: 1px solid #34373c; border-radius: 4px; font-size: 1.3rem; cursor: pointer; }
  .contact-status { font-size: .8rem; line-height: 1.6; padding: 14px; border-radius: 4px; overflow-wrap: anywhere; }
  .contact-status a { text-decoration: underline; }
  .contact-preview { background: #30251e; color: #e8ad73; }
  .contact-success { background: #173127; color: #9be0b3; }
  .contact-error { background: #371e24; color: #ffb5b5; }
  @media(max-width: 767px) {
    .contact-page { padding: 24px 20px 48px; }
    .contact-layout { grid-template-columns: 1fr; grid-template-areas: "intro" "form" "chat"; gap: 26px; }
    .contact-eyebrow { margin-top: 24px; }
    h1 { margin: 14px 0 16px; }
    h1 br { display: none; }
    .contact-lead { max-width: none; font-size: .9rem; }
    .contact-note { margin-top: 6px; font-size: .8rem; }
    .contact-form { padding: 22px 18px; margin-top: 0; gap: 20px; }
    .contact-chat { padding-top: 24px; }
  }
</style>
