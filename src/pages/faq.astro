---
import InformationPage from '../components/InformationPage.astro';
import { canonicalUrl, jsonLd } from '../lib/seo';
const faqs = [
  {
    "question": "Какой минимальный заказ?",
    "answer": "Фиксированного минимума нет. Количество согласуем по вашему запросу."
  },
  {
    "question": "Нужно заказывать целую коробку?",
    "answer": "Нет фиксированного требования заказывать целую коробку. Размер коробки в каталоге — характеристика упаковки."
  },
  {
    "question": "Можно сначала попробовать чай?",
    "answer": "Да, выберите до пяти позиций на странице образцов. Образцы платные, стоимость и доставку согласуем отдельно."
  },
  {
    "question": "Как узнать цену?",
    "answer": "Отправьте запрос из карточки чая. Название добавится автоматически, останутся имя и телефон."
  },
  {
    "question": "Не знаю, какой чай выбрать. Что делать?",
    "answer": "Напишите, для какого магазина или чайной выбираете. Начать можно без списка товаров и точного объёма."
  },
  {
    "question": "Нужен ли свой экспедитор?",
    "answer": "Для запроса он не обязателен. Передачу груза и доставку согласуем отдельно."
  },
  {
    "question": "Кто оплачивает доставку?",
    "answer": "Условия и стоимость доставки обсуждаем до отправки. Бесплатная доставка по умолчанию не предусмотрена."
  },
  {
    "question": "Вес и упаковка в каталоге актуальны?",
    "answer": "Указаны данные нашего каталога. Фактическую фасовку и наличие подтвердим по партии. Коробка не является минимальным заказом."
  },
  {
    "question": "Как уточнить оплату и документы?",
    "answer": "Условия оплаты согласуем по конкретному заказу. Доступность документов также проверим до согласования поставки."
  }
];
const answerIds = ['minimum-order', 'carton', 'paid-samples', 'price', 'tea-selection', 'forwarder', 'shipping', 'batch-details', 'payment-documents'];
const pageUrl = canonicalUrl('/faq/');
const schema = { "@context": "https://schema.org", "@type": "FAQPage", '@id': pageUrl + '#webpage', url: pageUrl, inLanguage: 'ru-RU', mainEntity: faqs.map((f, index) => ({ "@type": "Question", '@id': pageUrl + '#' + answerIds[index], name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) };
const groups = [
  { id: 'choice', title: 'Выбор и образцы', indices: [4, 2, 7] },
  { id: 'order', title: 'Количество и цена', indices: [0, 1, 3] },
  { id: 'delivery', title: 'Доставка и документы', indices: [5, 6, 8] },
];
const links: Record<number, [string, string]> = {
  2: ['/sample/', 'Выбрать образцы'],
  3: ['/catalog/', 'Найти чай в каталоге'],
  4: ['/contact/?topic=tea-selection#inquiry-form', 'Попросить помощь'],
  8: ['/compliance/', 'Документы к заказу'],
};
---
<InformationPage title="Вопросы перед заказом" description="Количество, образцы и доставка. Коротко о том, как начать закупку." path="/faq/" eyebrow="ВОПРОСЫ И ОТВЕТЫ" actionTitle="Остался вопрос?" actionText="Задать вопрос">
  <section class="faq-list" aria-label="Частые вопросы">
    <nav class="faq-jumps" aria-label="Темы вопросов">{groups.map(group => <a href={`#${group.id}`}>{group.title}</a>)}</nav>
    {groups.map(group => <section class="faq-group" id={group.id} aria-labelledby={`${group.id}-heading`}><h2 id={`${group.id}-heading`}>{group.title}</h2>{group.indices.map(index => <details id={answerIds[index]}><summary>{faqs[index].question}</summary><p>{faqs[index].answer}</p>{links[index] && <a class="faq-answer-link" href={links[index][0]}>{links[index][1]} →</a>}</details>)}</section>)}
  </section>
  <script slot="schema" type="application/ld+json" set:html={jsonLd(schema)}></script>
</InformationPage>
<script>
  function revealAnswer() {
    const id = location.hash.slice(1);
    const answer = document.getElementById(id);
    if (answer instanceof HTMLDetailsElement) {
      answer.open = true;
      answer.scrollIntoView({ block: 'start' });
    }
  }
  revealAnswer();
  document.addEventListener('astro:page-load', revealAnswer);
  window.addEventListener('hashchange', revealAnswer);
</script>
<style>
  details { scroll-margin-top: 100px; }
  details:target { outline: 1px solid #a87c53; outline-offset: 6px; }
  .faq-jumps { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 36px; }
  .faq-jumps a, .faq-answer-link { display: inline-flex; align-items: center; min-height: 44px; font-size: .85rem; color: #e8ad73; text-decoration: underline; text-underline-offset: 4px; }
  .faq-group + .faq-group { margin-top: 44px; }
  .faq-group { scroll-margin-top: 90px; }
  .faq-group h2 { color: #b7bac1; font-size: .85rem; letter-spacing: .04em; margin-bottom: 4px; }
  .faq-answer-link { margin-top: 10px; }
</style>
