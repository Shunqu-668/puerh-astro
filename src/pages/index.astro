---
import Layout from "../components/Layout.astro";
import Picture from "../components/Picture.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";
const selected = [products.find(p => p.slug === "2024-ripe-puerh-brick-black-pearl-xinwen")!, products.find(p => p.slug === "2018-raw-puerh-cake-yiwu")!, products.find(p => p.slug === "2013-ripe-puerh-tuocha-yongdegushutuocha")!];
---
<Layout title="Пуэр для вашего бизнеса — оптовый каталог чая" description="Шу и шэн пуэр для вашего ассортимента. Сравните чай, запросите платные образцы и предложение под свой объём. Доставка по согласованию." canonicalURL="/" ogImage="https://puerhdirect.ru/images/images/hero-bg.webp">
 <section class="home-hero section-shell">
  <div class="hero-copy"><p class="eyebrow">PUERH DIRECT / КИТАЙ → РОССИЯ</p><h1>Хороший чай.<br />Для вашего <em>дела.</em></h1><p class="hero-description">Пуэр для чайных магазинов и других закупщиков. От первого знакомства со вкусом — к партии для вашего ассортимента.</p><div class="hero-actions"><a href="/catalog/" class="button primary">Выбрать чай <span aria-hidden="true">↗</span></a><a href="/sample/" class="text-link">Начать с образцов →</a></div><p class="hero-footnote">Ваш объём. Согласованные условия.<br />Доставка с вашим экспедитором или по договорённости.</p></div>
  <div class="hero-visual"><img src="/images/images/hero-bg.webp" alt="Листовой пуэр в чайном совке" width="1920" height="1080" fetchpriority="high" class="hero-photo" /><div class="hero-photo-caption"><span>茶 / PUERH</span><span>Выбор начинается<br />со знакомства.</span></div></div>
 </section>
 <div class="collection-strip section-shell"><span><strong>42</strong> позиции пуэра</span><span><strong>Шу / Шэн</strong> два характера чая</span><span><strong>100–500 г</strong> вес одной штуки*</span><a href="/catalog/">Посмотреть коллекцию ↗</a></div>
 <section class="section-shell home-section">
  <div class="section-heading"><div><p class="eyebrow">01 / ДВА ХАРАКТЕРА</p><h2 class="display-title">Какой пуэр ваш?</h2></div><p>Начните с вида чая.<br />Затем сравните форму, год и вес.</p></div>
  <div class="category-pair">{[{type:"ripe",title:"Шу пуэр",note:"Ферментированный. Для знакомства с насыщенным вкусом.",image:"1.webp",en:"RIPE PUERH"},{type:"raw",title:"Шэн пуэр",note:"Естественная выдержка. Для знакомства с другим характером чая.",image:"2.webp",en:"RAW PUERH"}].map(c => <a href={`/catalog/${c.type}-puerh/`} class="category-feature"><div class="category-photo"><Picture src={`/images/images/${c.image}`} alt={c.title} class="w-full h-full object-cover" /></div><div class="category-caption"><div><p class="eyebrow">{c.en}</p><h3>{c.title}</h3><p>{c.note}</p></div><span class="circle-arrow" aria-hidden="true">↗</span></div></a>)}</div>
  <div class="secondary-categories"><span>Дополнить ассортимент</span><a href="/catalog/teaware/">Чайная посуда ↗</a><a href="/catalog/other-tea/">Другой чай ↗</a><a href="/private-label/">Под своим брендом ↗</a></div>
 </section>
 <section class="selection-section"><div class="section-shell home-section"><div class="section-heading"><div><p class="eyebrow">02 / РАЗНЫЕ ФОРМАТЫ</p><h2 class="display-title">Три повода познакомиться.</h2></div><a href="/catalog/" class="text-link">Все 42 позиции ↗</a></div><div class="product-grid featured-grid">{selected.map(p => <ProductCard product={p} />)}</div><p class="spec-note">* Вес и упаковка — по каталогу поставщика. Партию, наличие и цену подтверждаем в предложении.</p></div></section>
 <section class="section-shell home-section sample-editorial"><div class="sample-editorial-photo"><Picture src="/images/images/1.webp" alt="Чайный настой в стеклянном чахае" class="w-full h-full object-cover" /></div><div><p class="eyebrow">03 / СНАЧАЛА ВКУС</p><h2 class="display-title">Перед закупкой —<br /><em>чашка чая.</em></h2><p>Выберите до пяти позиций для запроса образцов. Сравните их на своей дегустации, прежде чем собирать заказ.</p><p class="sample-terms">Образцы платные. Состав, стоимость и доставку согласуем до отправки.</p><a href="/sample/" class="button primary">Подобрать образцы ↗</a></div></section>
 <section class="purchase-section"><div class="section-shell home-section"><p class="eyebrow">04 / ПОНЯТНЫЙ СЛЕДУЮЩИЙ ШАГ</p><h2 class="display-title">Ваш чай. Ваш объём.</h2><div class="purchase-steps">{[{n:"01",title:"Выберите позиции",text:"Сравните характеристики и укажите количество в штуках или килограммах."},{n:"02",title:"Получите предложение",text:"Уточним партию, упаковку и стоимость. Фиксированного минимального объёма обычного оптового заказа нет."},{n:"03",title:"Согласуйте доставку",text:"Обсудим сроки, расходы и передачу вашему экспедитору. Можно обратиться без готового маршрута."}].map(s => <div><span>{s.n}</span><h3>{s.title}</h3><p>{s.text}</p></div>)}</div><div class="purchase-bottom"><p>Уже знаете, что нужно вашему бизнесу?</p><a href="/contact/#inquiry-form" class="button light">Обсудить закупку ↗</a></div></div></section>
</Layout>
