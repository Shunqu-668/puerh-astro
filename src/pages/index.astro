---
import Layout from "../components/Layout.astro";
import Picture from "../components/Picture.astro";
import CompanyStory from "../components/CompanyStory.astro";
import { teaProfiles } from '../data/tea-profiles';
import { products, getProductImg, typeLabels, shapeLabels } from "../data/products";
import selection from "../data/home-selection.json";
import { catalogSpecs } from "../data/catalog-specs";
import "../styles/home.css";
const featured = selection.items.map(item => {
  const product = products.find(p => p.slug === item.slug);
  if (!product) throw new Error(`Unknown homepage product: ${item.slug}`);
  return { ...product, grams: catalogSpecs.get(item.slug)!.grams };
});
---
<Layout title="Пуэр оптом из Китая — шу и шэн для бизнеса"
  description="Шу и шэн пуэр для магазинов и чайных. Количество по запросу, образцы платные, доставка по согласованию."
  ogImage="https://puerhdirect.ru/images/images/hero-bg.webp" canonicalURL="/">
  <link slot="head" rel="preload" as="image" href="/images/images/hero-bg.webp" fetchpriority="high" />
  <div class="puerh-home">
    <section class="tea-hero">
      <img src="/images/images/hero-bg.webp" alt="" class="tea-hero-image" fetchpriority="high" width="1920" height="1080" />
      <div class="tea-hero-overlay"></div>
      <div class="shell tea-hero-content">
        <h1>Пуэр оптом<br />для вашего бизнеса</h1>
        <p class="tea-intro">Отбираем чай в Китае для магазинов и чайных.<br />От первого образца до собственной чайной марки.</p>
        <div class="tea-actions">
          <a href="#tea-selection" class="action-flame tea-button">Выбрать пуэр <span aria-hidden="true">→</span></a>
          <a href="/contact/#inquiry-form" class="tea-button tea-button-outline">Запросить цену</a>
        </div>
      </div>
    </section>
    <div class="tea-conditions">
      <div class="shell">
        <p><span>Закупка</span>Без фиксированного минимума</p>
        <p><span>Образцы</span>Платные, до пяти позиций</p>
        <p><span>Доставка</span>Условия согласуем отдельно</p>
      </div>
    </div>

    <section id="tea-selection" class="tea-selection">
      <div class="shell">
        <div class="tea-section-heading">
          <div><h2>Выберите свой пуэр</h2></div>
          <a href="/catalog/" class="tea-link">Все {products.length} позиции <span aria-hidden="true">→</span></a>
        </div>
        <nav class="tea-category-links" aria-label="Категории чая">
          <a href="/catalog/ripe-puerh/">Шу пуэр</a>
          <a href="/catalog/raw-puerh/">Шэн пуэр</a>
          <a href="/catalog/teaware/">Чайная посуда</a>
          <a href="/catalog/other-tea/">Другой чай</a>
        </nav>
        <div class="tea-product-grid">
          {featured.map(p => (
            <article class="tea-product">
              <a href={`/catalog/product/${p.slug}/`} class="tea-product-image" aria-label={`${p.nameRu}, ${p.year}`}>
                <Picture src={getProductImg(p)} fallback={getProductImg(p).replace(/\.webp$/, ".jpg")} alt={`${p.nameRu}, ${p.year}`} class="w-full h-full object-cover" loading="lazy" />
              </a>
              <div class="tea-product-info">
                <p class="tea-product-type">{typeLabels[p.type].ru} · {p.year}</p>
                <h3><a href={`/catalog/product/${p.slug}/`}>{p.nameRu}</a></h3>
                <p class="tea-product-taste">{teaProfiles[p.slug].notes.slice(0, 2).join(' · ') || teaProfiles[p.slug].occasion}</p>
                <p class="tea-product-spec">{shapeLabels[p.shape].ru} <span>·</span> {p.grams} г / шт.</p>
                <div class="tea-product-actions">
                  <a href={`/catalog/product/${p.slug}/`} class="tea-link">Подробнее <span aria-hidden="true">↗</span></a>
                  <a href={`/contact/?product=${encodeURIComponent(p.slug)}&tea=${encodeURIComponent(p.nameRu)}#inquiry-form`} class="tea-quote">Узнать цену</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <div class="shell"><CompanyStory /></div>
    <section class="tea-purchase">
      <div class="shell tea-purchase-grid">
        <div>
          <p class="tea-overline">ПЕРЕД ЗАКУПКОЙ</p>
          <h2>Сначала попробуйте чай</h2>
          <p>Выберите до пяти платных образцов.<br />Стоимость и доставку согласуем до отправки.</p>
          <a href="/sample/" class="tea-link">Выбрать образцы <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <p class="tea-overline">ВАШ БРЕНД</p>
          <h2>Чай под вашим брендом</h2>
          <p>Для магазина, чайной или подарочной серии.<br />Начать можно с идеи, без готового макета.</p>
          <a href="/private-label/" class="tea-link">Обсудить свой бренд <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</Layout>
